# Auto-detect text files and normalize line endings to LF
* text=auto

# Linux / Unix shell scripts must have LF endings
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts must have CRLF endings
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
*.jks binary

